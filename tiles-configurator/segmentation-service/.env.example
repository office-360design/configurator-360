# Copy to .env for Compose only. python -m server does NOT read .env automatically.
# Set process environment variables when running directly.
PAVING_PORT=8000
PAVING_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PAVING_ALLOWED_HOSTS=localhost,127.0.0.1,paving-analysis
PAVING_MAX_PENDING=4
PAVING_MAX_RESULTS=8
PAVING_RESULT_TTL_SECONDS=900
PAVING_MAX_CLIENTS=128
TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Hosted: replace origins with your exact HTTPS frontend origin(s), and add the
# forwarded public hostname to PAVING_ALLOWED_HOSTS. No wildcard or trailing slash.
# Do not put account/API credentials in segmentationConfig.js or in share links.
