# Set these in Netlify Project configuration -> Environment variables.
# Do not commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_BUCKET=window-ar-models
AR_ALLOWED_ORIGINS=https://brilliant-klepon-fbae3a.netlify.app

# Optional safety overrides. Defaults shown here keep usage below the Supabase
# Free-plan 1 GB storage quota while allowing the larger USDZ representation.
AR_MAX_GLB_BYTES=15728640
AR_MAX_USDZ_BYTES=62914560
AR_MAX_MODELS=90
AR_MAX_TOTAL_BYTES=838860800

# Legacy GLB-only setting. It is still accepted as the GLB limit when
# AR_MAX_GLB_BYTES is absent, but it does not limit USDZ files.
# AR_MAX_FILE_BYTES=15728640
