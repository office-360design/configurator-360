rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public tenant metadata used to bootstrap tenant subdomains.
    // Documents may be read individually by browsers but never listed or modified.
    match /tenantPublic/{tenantSlug} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }
    
    // Private tenant configuration.
    // Provisioning/backend functions use the Admin SDK, which bypasses Security Rules.
    match /tenants/{tenantSlug} {
      allow read, write: if false;
    }

    // Internal provisioning allowlist. Only Admin-SDK backend code may inspect
    // or modify the list of Firebase UIDs allowed to create customer tenants.
    match /tenantProvisioningAdmins/{uid} {
      allow read, write: if false;
    }

    // Per-tenant usage counters and quota telemetry are backend-only.
    match /tenantUsage/{tenantSlug}/months/{month} {
      allow read, write: if false;
    }

    // Configurator product analytics are aggregate backend telemetry. Browsers
    // record events only through the validated Cloud Function and cannot inspect
    // or alter aggregate counters directly.
    match /configuratorAnalytics/{scopeId}/{document=**} {
      allow read, write: if false;
    }

    // Tenant audit/activity history is append-only through trusted backend code.
    // Browsers receive filtered views through authenticated callable functions.
    match /tenantAuditLogs/{tenantSlug}/{document=**} {
      allow read, write: if false;
    }

    function loggedIn() {
      return request.auth.uid != null;
    }

    // carts
    match /carts/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // adaos
    match /adaos/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // categories
    match /categories/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // companies
    match /companies/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // colorsProducts
    match /colorsProducts/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // favorites
    match /favorites/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // glass
    match /glass/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // panels
    match /panels/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // wainscot
    match /wainscot/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // matrix (preserved exactly from the existing rules)
    match /glass/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // manufacturers
    match /manufacturers/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // orders
    match /orders/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // products
    match /products/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // providers
    match /providers/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // pvc
    match /pvc/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // pvcColorsGroups
    match /pvcColorsGroups/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // pvcColorsPatterns
    match /pvcColorsPatterns/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // shapes
    match /shapes/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // toc
    match /toc/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }
    // matrices
    match /matrices/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }

    // users
    match /users/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }

    // Private configurator saves are never exposed directly to browser Firestore.
    // The authenticated callable functions use the Admin SDK and verify request.auth.uid,
    // so one account can never list/read/write another account's configurations.
    match /users/{userId}/savedConfigurations/{product}/items/{configurationId} {
      allow read, write: if false;
    }

    // Tier-1 customer saves are additionally isolated by tenant. Browser access
    // is still forbidden; authenticated Cloud Functions derive the tenant from
    // the trusted request Origin and use the Admin SDK.
    match /users/{userId}/tenantSavedConfigurations/{tenantSlug}/products/{product}/items/{configurationId} {
      allow read, write: if false;
    }

    // Shopping-cart rows are immutable snapshots of saved configurations. The
    // public country domains share users/{uid}/shoppingCart, while customer
    // tenants use a tenant-isolated subtree. Browser Firestore access remains
    // disabled; authenticated Cloud Functions bind every operation to request.auth.uid.
    match /users/{userId}/shoppingCart/{product}/items/{cartItemId} {
      allow read, write: if false;
    }
    match /users/{userId}/tenantShoppingCart/{tenantSlug}/products/{product}/items/{cartItemId} {
      allow read, write: if false;
    }

    // Legacy mutable cart document retained only so the backend can migrate old
    // carts once. Clients never receive direct access to it.
    match /users/{userId}/carts/{scopeId} {
      allow read, write: if false;
    }

    // Cross-domain authentication handoffs contain only server-side temporary
    // state and are redeemed through Cloud Functions. Browser Firestore access
    // is intentionally impossible.
    match /domainAuthHandoffs/{handoffId} {
      allow read, write: if false;
    }

    // generatedOffers
    match /generatedOffers/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }

    // accessories - shapes
    match /accshapes/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }

    // accessories - types
    match /acctypes/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }

    // accessories - matrices
    match /accmatrices/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }
    // statistics
    match /statistics/{item} {
      allow read, create;
      allow update, delete: if loggedIn();
    }
    // producers
    match /producers/{item} {
      allow read;
      allow create, update, delete: if loggedIn();
    }

    // Internal share-system state. Clients cannot read or modify it directly;
    // Security Rules may still consult it when deciding whether the temporary
    // reCAPTCHA-free fallback is currently authorized by the backend.
    match /sharedConfigurationSystem/{item} {
      allow read, write: if false;
    }

    // Anonymous MCP creation quotas are maintained only by the Cloud Run
    // service account. Browsers cannot inspect or alter hashed rate counters.
    match /chatgptPluginRateLimits/{item} {
      allow read, write: if false;
    }

    function shareUsageControlPath() {
      return /databases/$(database)/documents/sharedConfigurationSystem/appCheckUsage;
    }

    function existingShareControlAllowsLegacyCreate() {
      let control = get(shareUsageControlPath()).data;
      return !('secureModeActive' in control)
          || control.secureModeActive != true
          || (
            ('legacyFallbackEnabled' in control)
            && control.legacyFallbackEnabled == true
            && ('fallbackUntil' in control)
            && control.fallbackUntil is timestamp
            && control.fallbackUntil > request.time
          );
    }

    function legacyShareCreateAllowed() {
      // Before the first successful App Check-protected share, keep the existing
      // implementation available so rollout/configuration cannot break Share.
      // Once secureModeActive becomes true, direct writes are allowed only while
      // the server-authorized fallback window is still open.
      return !exists(shareUsageControlPath())
          || existingShareControlAllowsLegacyCreate();
    }

    // shared configurator links
    match /sharedConfigurations/{shareId} {
      // Opening an exact bearer-style share link remains reCAPTCHA-free. Listing
      // or searching the collection is forbidden, and expired documents stop
      // reading exactly at expiresAt even if TTL deletion has not run yet.
      allow get: if shareId.matches('[A-Za-z0-9_-]{16}')
          && resource.data.v == 1
          && resource.data.p in ['window', 'roof', 'pergola', 'hall', 'solar', 'fence']
          && resource.data.s is string
          && (
            !('expiresAt' in resource.data)
            || (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time)
          );

      allow list: if false;

      // Direct browser creation is the no-reCAPTCHA compatibility/fallback path.
      // It is open before the first successful App Check rollout, then gated by
      // the private backend control document. At 9,500 monthly assessments the
      // backend reopens it until the first instant of the next UTC month.
      allow create: if legacyShareCreateAllowed()
          && shareId.matches('[A-Za-z0-9_-]{16}')
          && request.resource.data.keys().hasAll(['v', 'p', 's'])
          && request.resource.data.keys().hasOnly(['v', 'p', 's'])
          && request.resource.data.v == 1
          && request.resource.data.p in ['window', 'roof', 'pergola', 'hall', 'solar', 'fence']
          && request.resource.data.s is string
          && request.resource.data.s.size() > 0
          && request.resource.data.s.size() <= 850000;

      allow update, delete: if false;
    }
  }
}
