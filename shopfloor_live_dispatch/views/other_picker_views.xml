<odoo>
  <record id="view_shopfloor_live_other_pick_form" model="ir.ui.view">
    <field name="name">shopfloor.live.other.pick.form</field>
    <field name="model">shopfloor.live.other.pick</field>
    <field name="arch" type="xml">
      <form string="Alege activitatea" create="false" edit="false" delete="false" class="wk_popup_no_footer">
        <sheet>

          <group invisible="1">
            <field name="x_session_id"/>
            <field name="x_employee_id"/>
          </group>

          <div style="text-align:center; padding:10px 12px 4px 12px;">
            <div style="font-size:28px; font-weight:800; color:#111827;">
              Alege activitatea
            </div>
          </div>

          <field name="x_line_ids" nolabel="1" readonly="1">
            <kanban string="Alege activitatea"
                    class="o_kanban_mobile"
                    create="false"
                    quick_create="false"
                    edit="false"
                    delete="false"
                    can_open="false">

              <field name="x_name"/>
              <field name="x_description"/>
              <field name="x_other_operation_id"/>

              <templates>
                <t t-name="card">
                  <div class="oe_kanban_card shadow-sm"
                       style="border-radius:16px;
                              padding:14px 16px;
                              margin:6px 8px;
                              border:1px solid #e5e7eb;
                              background:#ffffff;
                              min-height:220px;
                              display:flex;
                              flex-direction:column;">

                    <div style="font-size:24px;
                                font-weight:800;
                                color:#111827;
                                text-align:center;
                                line-height:1.12;">
                      <field name="x_name"/>
                    </div>

                    <div t-if="record.x_description.raw_value"
                         style="font-size:16px;
                                font-weight:600;
                                color:#6b7280;
                                margin-top:8px;
                                line-height:1.35;
                                white-space:normal;">
                      <field name="x_description"/>
                    </div>

                    <div style="margin-top:auto; padding-top:12px;">
                      <button name="action_choose_other_activity"
                              type="object"
                              string="Selectează"
                              class="btn btn-primary wk_btn_xl shadow-sm"
                              style="width:100%;
                                     max-width:none;
                                     padding-top:10px;
                                     padding-bottom:10px;"/>
                    </div>

                  </div>
                </t>
              </templates>

            </kanban>
          </field>

          <div class="wk_btn_row"
               style="display:flex; width:100%; gap:16px; margin:24px 0 0 0; box-sizing:border-box;">
            <button string="Înapoi"
                    name="action_back_to_session"
                    type="object"
                    class="btn btn-secondary wk_btn_xl shadow-sm"
                    style="flex:1 1 100%; width:100%; min-width:0; max-width:none;"/>
          </div>

        </sheet>
      </form>
    </field>
  </record>
</odoo>
