<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopfloor_force_close_production_wizard_form" model="ir.ui.view">
        <field name="name">shopfloor.force.close.production.wizard.form</field>
        <field name="model">shopfloor.force.close.production.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmare finalizare">
                <group>
                    <field name="production_id" invisible="1"/>
                    <field name="confirmation_message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm_force_close"
                            type="object"
                            string="Finalizează"
                            class="btn-primary"/>
                    <button string="Anulează" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
