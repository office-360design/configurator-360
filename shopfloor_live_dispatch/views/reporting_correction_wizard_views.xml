<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopfloor_reporting_correction_wizard_form" model="ir.ui.view">
        <field name="name">shopfloor.reporting.correction.wizard.form</field>
        <field name="model">shopfloor.reporting.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Corectează raportarea">
                <field name="slot_id" invisible="1"/>
                <group>
                    <group>
                        <field name="production_name"/>
                        <field name="workorder_name"/>
                        <field name="employee_name"/>
                    </group>
                    <group>
                        <field name="target_qty"/>
                        <field name="current_workorder_done"/>
                        <field name="corrected_workorder_done"/>
                    </group>
                </group>
                <group string="Corecție interval">
                    <field name="old_interval_qty" readonly="1"/>
                    <field name="corrected_interval_qty"/>
                    <field name="correction_reason" placeholder="Ex.: Au fost raportate accidental toate bucățile rămase; în interval s-au realizat efectiv 500 buc."/>
                </group>
                <group>
                    <field name="downstream_summary" readonly="1" nolabel="1"/>
                    <field name="bonus_summary" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_apply_correction"
                            type="object"
                            string="Aplică corecția"
                            class="btn-primary"
                            confirm="Corecția va modifica progresul operației, starea Gantt și eventual datele deja importate în bonusare. Continuați?"/>
                    <button string="Anulează" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopfloor_reporting_correction_wizard" model="ir.actions.act_window">
        <field name="name">Corectează raportarea</field>
        <field name="res_model">shopfloor.reporting.correction.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_shopfloor_reporting_correction_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
